GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SITE_URL=http://localhost:8010
SITE_NAME=Sarkari Match

# Paid alerts. Leave Razorpay keys empty for demo mode (free activation).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALERT_PRICE_INR=99
ALERT_PASS_DAYS=180
ALERTS_TOKEN_SECRET=
ALERTS_CRON_SECRET=
# Email delivery (resend.com). Without a key, alerts are printed instead of sent.
RESEND_API_KEY=
ALERT_FROM=alerts@yourdomain.com
# SUBSCRIBERS_FILE=/var/data/subscribers.json   # put on a persistent disk in production
